// AlmaLink Prisma Database Schema
// Institution: MES Institute of Management & Career Courses (IMCC), Pune
// Database: Supabase PostgreSQL (Dual-URL standard for connection pooling & direct migrations)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. AUTHENTICATION & ACCESS CONTROL (RBAC)
// ==========================================

model Role {
  roleId Int    @id @default(autoincrement()) @map("role_id")
  name   String @unique @db.VarChar(50) // SUPER_ADMIN, COLLEGE_ADMIN, CELL_COORDINATOR, ALUMNI

  users User[]

  @@map("roles")
}

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  roleId       Int      @map("role_id")
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(100)
  phone        String   @db.VarChar(20)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(500)
  status       String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, ARCHIVED, INVITED
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [roleId])

  // Profile Relations
  alumniProfile   AlumniProfile?
  cellCoordinator CellCoordinator?

  // Administrative & Coordinator Ownerships
  headedCells             Cell[]             @relation("CellHeadStaff")
  createdActivities       Activity[]         @relation("ActivityCreator")
  sentInvitations         Invitation[]       @relation("InvitationSender")
  verifiedParticipations  Participation[]    @relation("ParticipationVerifier")
  verifiedAlumni          AlumniProfile[]    @relation("AlumniVerifier")
  updatedScoringPolicies  ScoringPolicy[]    @relation("PolicyUpdater")
  awardNominations        AwardNomination[]  @relation("AwardNominator")
  awardVotes              AwardVote[]        @relation("AwardVoter")
  auditLogs               AuditLog[]         @relation("AuditActor")
  notifications           Notification[]     @relation("UserNotifications")

  @@map("users")
}

// ==========================================
// 2. COLLEGE CELL & STAFF MANAGEMENT
// ==========================================

model Cell {
  cellId      Int      @id @default(autoincrement()) @map("cell_id")
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(20) // TECH, PLACE, CULT, SPORTS, ENTREPRENEURSHIP
  description String?  @db.Text
  headStaffId Int?     @map("head_staff_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  headStaff User? @relation("CellHeadStaff", fields: [headStaffId], references: [userId])

  coordinators     CellCoordinator[]
  activities       Activity[]
  awardNominations AwardNomination[]

  @@map("cells")
}

model CellCoordinator {
  cellId     Int      @map("cell_id")
  userId     Int      @unique @map("user_id") // Strict rule: 1 coordinator belongs to only 1 cell
  assignedOn DateTime @default(now()) @map("assigned_on") @db.Date

  cell Cell @relation(fields: [cellId], references: [cellId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([cellId, userId])
  @@map("cell_coordinators")
}

// ==========================================
// 3. ALUMNI PROFILE & VERIFICATION
// ==========================================

model AlumniProfile {
  alumniId             Int       @id @default(autoincrement()) @map("alumni_id")
  userId               Int       @unique @map("user_id")
  program              String    @db.VarChar(50) // MCA, MBA
  graduationYear       Int       @map("graduation_year")
  enrollmentNo         String    @unique @map("enrollment_no") @db.VarChar(50)
  organization         String?   @db.VarChar(150)
  designation          String?   @db.VarChar(100)
  industry             String?   @db.VarChar(100)
  linkedinUrl          String?   @map("linkedin_url") @db.VarChar(500)
  experienceYears      Int?      @map("experience_years")
  skills               Json      @default("[]") // Array of skill tags e.g. ["React", "Python"]
  expertise            Json      @default("[]") // Array of domain tags e.g. ["Cloud Architecture"]
  preferredActivities  Json      @default("[]") @map("preferred_activities") // ["Guest Lectures", "Hackathon"]
  preferredFormat      String?   @map("preferred_format") @db.VarChar(20) // Online, In-Person, Hybrid
  availability         String?   @db.VarChar(100)
  areaOfInterest       String?   @map("area_of_interest") @db.Text
  willingToParticipate Boolean   @default(true) @map("willing_to_participate")
  consentGiven         Boolean   @default(false) @map("consent_given")
  profileCompleted     Boolean   @default(false) @map("profile_completed")
  verificationStatus   String    @default("PENDING") @map("verification_status") @db.VarChar(20) // PENDING, VERIFIED, REJECTED
  verificationNote     String?   @map("verification_note") @db.Text
  verifiedById         Int?      @map("verified_by")
  verifiedAt           DateTime? @map("verified_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  verifiedBy User? @relation("AlumniVerifier", fields: [verifiedById], references: [userId])

  invitations      Invitation[]
  participations   Participation[]
  awardNominations AwardNomination[]

  @@map("alumni_profiles")
}

// ==========================================
// 4. ACTIVITY & EVENT MANAGEMENT
// ==========================================

model ActivityCategory {
  categoryId Int    @id @default(autoincrement()) @map("category_id")
  name       String @unique @db.VarChar(100) // Guest Lecture, Hackathon, Mock Interview, Sports

  activities Activity[]

  @@map("activity_categories")
}

model Activity {
  activityId        Int      @id @default(autoincrement()) @map("activity_id")
  cellId            Int      @map("cell_id")
  categoryId        Int      @map("category_id")
  createdBy         Int      @map("created_by")
  title             String   @db.VarChar(150)
  description       String   @db.Text
  requiredExpertise Json     @default("[]") @map("required_expertise") // Tags used for matchmaking
  startAt           DateTime @map("start_at")
  endAt             DateTime @map("end_at")
  venue             String   @db.VarChar(200)
  meetingLink       String?  @map("meeting_link") @db.VarChar(500)
  pointsWeight      Int      @default(10) @map("points_weight") // Activity-specific scoring override
  status            String   @default("DRAFT") @db.VarChar(20) // DRAFT, PUBLISHED, ONGOING, COMPLETED
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  cell     Cell             @relation(fields: [cellId], references: [cellId])
  category ActivityCategory @relation(fields: [categoryId], references: [categoryId])
  creator  User             @relation("ActivityCreator", fields: [createdBy], references: [userId])

  invitations    Invitation[]
  participations Participation[]

  @@map("activities")
}

// ==========================================
// 5. INVITATIONS & SMART ENGAGEMENT
// ==========================================

model Invitation {
  invitationId     Int       @id @default(autoincrement()) @map("invitation_id")
  activityId       Int       @map("activity_id")
  alumniId         Int       @map("alumni_id")
  sentBy           Int       @map("sent_by")
  expectedRole     String    @map("expected_role") @db.VarChar(100)
  responseDeadline DateTime  @map("response_deadline") @db.Date
  responseNote     String?   @map("response_note") @db.Text
  sentViaEmail     Boolean   @default(false) @map("sent_via_email")
  sentViaWhatsapp  Boolean   @default(false) @map("sent_via_whatsapp")
  status           String    @default("SENT") @db.VarChar(20) // DRAFT, SENT, ACCEPTED, DECLINED, EXPIRED
  sentAt           DateTime  @default(now()) @map("sent_at")
  respondedAt      DateTime? @map("responded_at")

  activity Activity      @relation(fields: [activityId], references: [activityId], onDelete: Cascade)
  alumni   AlumniProfile @relation(fields: [alumniId], references: [alumniId], onDelete: Cascade)
  sender   User          @relation("InvitationSender", fields: [sentBy], references: [userId])

  participation Participation?

  @@map("invitations")
}

// ==========================================
// 6. PARTICIPATION & IMMUTABLE POINTS LEDGER
// ==========================================

model Participation {
  participationId  Int       @id @default(autoincrement()) @map("participation_id")
  activityId       Int       @map("activity_id")
  alumniId         Int       @map("alumni_id")
  invitationId     Int?      @unique @map("invitation_id")
  role             String    @db.VarChar(100)
  contributionType String?   @map("contribution_type") @db.VarChar(100)
  attended         Boolean   @default(false)
  pointsAwarded    Int       @default(0) @map("points_awarded") // Immutable ledger unit
  evidenceUrl      String?   @map("evidence_url") @db.VarChar(500)
  completionStatus String?   @map("completion_status") @db.VarChar(50)
  verifiedById     Int?      @map("verified_by")
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  activity   Activity      @relation(fields: [activityId], references: [activityId], onDelete: Cascade)
  alumni     AlumniProfile @relation(fields: [alumniId], references: [alumniId], onDelete: Cascade)
  invitation Invitation?   @relation(fields: [invitationId], references: [invitationId])
  verifiedBy User?         @relation("ParticipationVerifier", fields: [verifiedById], references: [userId])

  @@map("participations")
}

// ==========================================
// 7. SCORING POLICY (CONFIGURABLE RUBRIC)
// ==========================================

model ScoringPolicy {
  policyId      Int      @id @default(autoincrement()) @map("policy_id")
  activityType  String   @unique @map("activity_type") @db.VarChar(100) // Guest Lecture, Hackathon, Mock Interview
  defaultPoints Int      @map("default_points")
  description   String?  @db.Text
  updatedById   Int      @map("updated_by")
  updatedAt     DateTime @updatedAt @map("updated_at")

  updatedBy User @relation("PolicyUpdater", fields: [updatedById], references: [userId])

  @@map("scoring_policies")
}

// ==========================================
// 8. ANNUAL RECOGNITION & AWARDS
// ==========================================

model AwardNomination {
  nominationId   Int      @id @default(autoincrement()) @map("nomination_id")
  academicYear   String   @map("academic_year") @db.VarChar(20) // e.g. "2026-27"
  cellId         Int      @map("cell_id")
  alumniId       Int      @map("alumni_id")
  nominatedById  Int      @map("nominated_by")
  justification  String   @db.Text
  status         String   @default("SUBMITTED") @db.VarChar(20) // SUBMITTED, SHORTLISTED, WINNER
  certificateUrl String?  @map("certificate_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  cell        Cell          @relation(fields: [cellId], references: [cellId])
  alumni      AlumniProfile @relation(fields: [alumniId], references: [alumniId])
  nominatedBy User          @relation("AwardNominator", fields: [nominatedById], references: [userId])

  votes AwardVote[]

  // Constraint: One alumnus can only be nominated once per cell per academic year
  @@unique([cellId, alumniId, academicYear])
  @@map("award_nominations")
}

model AwardVote {
  voteId       Int      @id @default(autoincrement()) @map("vote_id")
  nominationId Int      @map("nomination_id")
  voterId      Int      @map("voter_id")
  academicYear String   @map("academic_year") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  nomination AwardNomination @relation(fields: [nominationId], references: [nominationId], onDelete: Cascade)
  voter      User            @relation("AwardVoter", fields: [voterId], references: [userId])

  // Constraint: One staff member can only cast one vote per academic year
  @@unique([voterId, academicYear])
  @@map("award_votes")
}

// ==========================================
// 9. AUDIT LOGS & NOTIFICATIONS
// ==========================================

model AuditLog {
  logId      Int      @id @default(autoincrement()) @map("log_id")
  userId     Int      @map("user_id")
  action     String   @db.VarChar(50) // ALUMNI_VERIFIED, STAFF_INVITED, etc.
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   Int      @map("entity_id")
  details    String?  @db.Text
  ipAddress  String   @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation("AuditActor", fields: [userId], references: [userId])

  @@map("audit_logs")
}

model Notification {
  notificationId Int      @id @default(autoincrement()) @map("notification_id")
  userId         Int      @map("user_id")
  title          String   @db.VarChar(150)
  message        String   @db.Text
  type           String   @db.VarChar(50)
  link           String?  @db.VarChar(500)
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [userId], onDelete: Cascade)

  @@map("notifications")
}

